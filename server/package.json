{
  "name": "rush-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Rush chat backend: holds the Claude API key and passes chat messages through. Stores nothing.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "eval": "node --experimental-strip-types --no-warnings eval/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  }
}
